# Скопируйте этот файл в .env и задайте реальные секреты.
# .env не коммитится в git (.gitignore). Никогда не храните секреты в репо.

# Обязательные секреты (прод)
DB_PASSWORD=change-me-strong-password
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Опционально
DB_USER=postgres
DB_NAME=franchise_db

# Фронтенд (базовый URL бэкенда; для k8s — внутренний сервис)
NEXT_PUBLIC_API_URL=http://localhost:8080