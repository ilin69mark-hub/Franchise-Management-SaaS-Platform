# Скопируйте этот файл в .env и задайте реальные секреты.
# .env не коммитится в git (.gitignore). Никогда не храните секреты в репо.

# Обязательные секреты (прод)
# AUDIT-EXCEPTION(E02): owner-key, см. .audit-exceptions.yml
DB_PASSWORD=change-me-strong-password
# AUDIT-EXCEPTION(E01): owner-key, см. .audit-exceptions.yml
JWT_SECRET=CHANGE_ME_JWT_SECRET

# Опционально
DB_USER=postgres
DB_NAME=franchise_db

# Фронтенд (базовый URL бэкенда; для k8s — внутренний сервис)
# В проде обязательно задайте публичный домен API, иначе прод-сборка упадёт (fail-closed).
NEXT_PUBLIC_API_URL=http://localhost:8080
# WebSocket (опционально; если не задан — выводится из NEXT_PUBLIC_API_URL)
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws/alerts

# --- Инфраструктура (опционально, дефолты в config.go) ---
# Порты/хосты БД (для локального запуска вне docker)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=franchise_db
# DB_USER=postgres
# Порт бэкенда (дефолт 8080)
# PORT=8080
# Redis (в docker-compose.prod хардкод redis:6379; вне docker — localhost)
# REDIS_URL=redis://localhost:6379
# CORS (если фронт и бэк на разных доменах — задайте в проде)
# CORS_ALLOWED_ORIGINS=https://example.com
# Seed-пароль для демо-пользователей (если не задан — генерируется случайный, см. seed.go)
# SEED_PASSWORD=change-me
# JWT время жизни (24h)
# JWT_EXPIRES=24h

# --- Ключи, которые выдаёт только человек (прод без них не запускать) ---
# Реестр: .audit-exceptions.yml (E03–E07, E10). Значения — только в .env на VPS,
# никогда в репо. Плейсхолдеры ниже — не секреты, менять на выданное человеком.
# AUDIT-EXCEPTION(E03): owner-key, см. .audit-exceptions.yml
# Telegram Bot API: создать у @BotFather, токен вставить в .env на VPS
# TG_BOT_TOKEN=CHANGE_ME_TG_BOT_TOKEN
# AUDIT-EXCEPTION(E04): owner-key, см. .audit-exceptions.yml
# Telegram Stars / платежи: подключить провайдера в @BotFather, токен — в .env
# STARS_PROVIDER_TOKEN=CHANGE_ME_STARS_PROVIDER_TOKEN
# AUDIT-EXCEPTION(E05): owner-key, см. .audit-exceptions.yml
# Web Push VAPID: сгенерировать (npx web-push generate-vapid-keys), обе части — в .env
# VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
# AUDIT-EXCEPTION(E06): owner-key, см. .audit-exceptions.yml
# Bootstrap super-admin: одноразовый токен владельца для первой настройки, затем удалить
# ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN
# AUDIT-EXCEPTION(E07): owner-key, см. .audit-exceptions.yml
# Получатели критических алертов: Telegram user id через запятую (узнать у @userinfobot)
# ADMIN_TG_IDS=CHANGE_ME_ADMIN_TG_IDS
# AUDIT-EXCEPTION(E10): owner-key, см. .audit-exceptions.yml
# Шифрование бэкапов: fingerprint/import GPG-ключа владельца на VPS
# BACKUP_GPG_KEY_ID=CHANGE_ME_BACKUP_GPG_KEY_ID