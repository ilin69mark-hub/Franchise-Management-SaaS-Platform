# === СТАДИЯ 1: DEVELOPMENT (с AIR) ===
FROM golang:1.24-alpine AS development

WORKDIR /app

RUN apk add --no-cache curl wget

RUN go install github.com/air-verse/air@v1.52.3

# Копируем зависимости
COPY backend/go.mod backend/go.sum ./
RUN go mod download

# Копируем весь код бэкенда
COPY backend/ .

# Копируем конфиг Air
COPY backend/.air.toml .

# Запускаем Air
CMD ["air", "-c", ".air.toml"]


# === СТАДИЯ 2: BUILDER (для продакшена) ===
FROM golang:1.24-alpine AS builder

RUN apk add --no-cache git
WORKDIR /app

COPY backend/go.mod backend/go.sum ./
RUN go mod download

COPY backend/ .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o main cmd/server/main.go


# === СТАДИЯ 3: PRODUCTION (финальный образ) ===
FROM alpine:3.19 AS production

RUN apk add --no-cache ca-certificates wget && adduser -D -g '' appuser

WORKDIR /home/appuser/

COPY --from=builder /app/main ./main

EXPOSE 8080

USER appuser

CMD ["./main"]